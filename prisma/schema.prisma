datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Habit {
  id          String     @id @default(uuid())
  name        String
  description String?
  icon        String     
  color       String     
  type        String     @default("good") // "good" | "bad"
  daysOfWeek  Int[]      
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  date      String   // Format YYYY-MM-DD
  completed Boolean  @default(true)
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

model Task {
  id        String   @id @default(uuid())
  text      String
  completed Boolean  @default(false)
  priority  String   // "high", "medium", "low"
  date      String   // Format YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([date])
}

model StickyNote {
  id        String   @id @default(uuid())
  content   String
  color     String
  createdAt DateTime @default(now())
}

model DailyReflection {
  id         String   @id @default(uuid())
  date       String   @unique // Format YYYY-MM-DD
  flowRating Int      
  victory    String?  
  lesson     String?  
  notes      String?  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}
